{
  "_como": [
    "O que do repositório roda no Dell a partir de uma CÓPIA instalada, e onde.",
    "O dell-status compara cada cópia com o ~/SquadOne (verificação 'Arquivos instalados').",
    "Script novo que é instalado fora do ~/SquadOne entra aqui no mesmo PR.",
    "repo: caminho no repositório; com curinga (*), vale só para o que já está instalado (testes e scripts de uso único ficam no repo).",
    "instalado: destino; terminado em / é uma pasta e o arquivo mantém o nome.",
    "modo: permissão do install (padrão 755 em ~/.local/bin, 644 no resto).",
    "reiniciar: unit que fica rodando e só relê o arquivo no boot.",
    "via: 'aplicar-hermes' quando quem instala é o deploy/hermes/scripts/aplicar-hermes.py."
  ],
  "arquivos": [
    {"repo": "deploy/dell/dell-status.py", "instalado": "~/.local/bin/dell-status"},
    {"repo": "deploy/dell/atualizar-central.sh", "instalado": "~/.local/bin/atualizar-central"},
    {"repo": "deploy/dell/auto-entrada.py", "instalado": "~/.local/bin/auto-entrada"},
    {"repo": "deploy/dell/backup/backup-dell.py", "instalado": "~/.local/bin/backup-dell"},
    {"repo": "deploy/dell/backup/estrutura-coletar.py", "instalado": "~/.local/bin/estrutura-coletar"},
    {"repo": "deploy/dell/backup/fontes.toml", "instalado": "~/.config/backup-dell/fontes.toml", "modo": "600"},
    {"repo": "deploy/dell/site-demos-limpeza.py", "instalado": "~/.local/bin/site-demos-limpeza"},
    {"repo": "deploy/dell/site-demos-pausa.py", "instalado": "~/.local/bin/site-demos-pausa"},
    {"repo": "deploy/dell/site-pastas.py", "instalado": "~/.local/bin/site-pastas"},
    {"repo": "deploy/dell/gerador-de-sites.py", "instalado": "~/.local/bin/gerador-de-sites"},
    {"repo": "deploy/dell/lote-continuo.py", "instalado": "~/.local/bin/lote-continuo"},
    {"repo": "deploy/dell/auto-site/auto-site-CLAUDE.md", "instalado": "~/auto-site/CLAUDE.md", "modo": "444"},
    {"repo": "deploy/dell/auto-site/lead-novo.md", "instalado": "~/auto-site/.claude/commands/lead-novo.md", "modo": "444"},
    {"repo": "deploy/dell/whatsapp-observador/observador.py", "instalado": "~/.local/bin/whatsapp-observador",
     "reiniciar": "whatsapp-observador"},
    {"repo": "deploy/dell/dell-worker-healthwatch.sh", "instalado": "~/.local/bin/dell-worker-healthwatch.sh",
     "reiniciar": "dell-worker-healthwatch"},
    {"repo": "deploy/dell/prumo-mapa/*.py", "instalado": "~/.local/share/prumo-mapa/"},
    {"repo": "deploy/dell/prumo-mapa/archivo.woff2", "instalado": "~/.local/share/prumo-mapa/"},
    {"repo": "deploy/dell/claude-ops/*.py", "instalado": "~/.local/share/claude-ops/"},
    {"repo": "deploy/dell/claude-ops/*.js", "instalado": "~/.local/share/claude-ops/"},
    {"repo": "deploy/dell/entrada/*.py", "instalado": "~/.local/lib/mel-entrada/", "reiniciar": "entrada"},
    {"repo": "deploy/dell/entrada/pagina.html", "instalado": "~/.local/lib/mel-entrada/", "reiniciar": "entrada"},
    {"repo": "deploy/dell/entrada/bin/cofre", "instalado": "~/.local/bin/cofre"},
    {"repo": "deploy/dell/entrada/bin/entrada_organizar.py", "instalado": "~/.hermes/scripts/entrada_organizar.py"},
    {"repo": "deploy/dell/**/*.service", "instalado": "~/.config/systemd/user/"},
    {"repo": "deploy/dell/**/*.timer", "instalado": "~/.config/systemd/user/"},
    {"repo": "deploy/dell/**/*.path", "instalado": "~/.config/systemd/user/"},
    {"repo": "deploy/hermes/SOUL.md", "instalado": "~/.hermes/SOUL.md", "via": "aplicar-hermes"},
    {"repo": "deploy/hermes/skills/dell-operations-manager/SKILL.md",
     "instalado": "~/.hermes/skills/dell-operations-manager/SKILL.md", "via": "aplicar-hermes"},
    {"repo": "deploy/hermes/skills/mapa-do-ecossistema/SKILL.md",
     "instalado": "~/.hermes/skills/mapa-do-ecossistema/SKILL.md", "via": "aplicar-hermes"},
    {"repo": "deploy/hermes/scripts/graphify_projetos.py", "instalado": "~/.hermes/scripts/", "via": "aplicar-hermes"},
    {"repo": "deploy/hermes/scripts/asmr_coleta_gate.py", "instalado": "~/.hermes/scripts/", "via": "aplicar-hermes"},
    {"repo": "deploy/hermes/scripts/sites_e_pendencias.py", "instalado": "~/.hermes/scripts/", "via": "aplicar-hermes"},
    {"repo": "deploy/hermes/scripts/site_antes_venda_watcher.py", "instalado": "~/.hermes/scripts/", "via": "aplicar-hermes"}
  ]
}
