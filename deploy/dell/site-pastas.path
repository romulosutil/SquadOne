[Unit]
Description=Pedidos para mover pastas da pasta auto (Balcão e botões da página do lead)

[Path]
PathChanged=%h/.local/share/n8n-estado/site-pastas.json
# Botões da página do lead (fluxo 07): um pacote por toque; o site-pastas apaga
# o que leu, então "não vazio" não dispara em loop.
DirectoryNotEmpty=%h/.local/share/n8n-estado/site-acoes
MakeDirectory=yes

[Install]
WantedBy=default.target
