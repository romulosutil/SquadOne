[Unit]
Description=Pedidos para mover pastas da pasta auto (Balcão e botões da página do lead)

[Path]
PathChanged=%h/.local/share/n8n-estado/site-pastas.json
# Botões da página do lead (fluxo 07): um pacote por toque; o site-pastas lê só *.json e apaga o que leu
# (ou o manda para site-acoes-erro). Com "diretório não vazio", uma sobra de outro tipo reacionava o serviço
# em laço até o limite de início, e o .path ficava failed calado (DELL-17, auditoria de 19/10/2026).
PathExistsGlob=%h/.local/share/n8n-estado/site-acoes/*.json
MakeDirectory=yes

[Install]
WantedBy=default.target
