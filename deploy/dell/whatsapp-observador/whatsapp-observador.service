[Unit]
Description=Observador do WhatsApp — conversa com lead marca a planilha (lê o log da bridge do Hermes)
After=hermes-gateway.service

[Service]
# A conversa dos leads vai para ~/.local/share/whatsapp-conversas (WHATSAPP_CONVERSAS_DIR), com origem "pessoal".
Environment=OBSERVADOR_ORIGEM=pessoal
ExecStart=/usr/bin/python3 %h/.local/bin/whatsapp-observador
Restart=always
RestartSec=15
MemoryMax=100M

[Install]
WantedBy=default.target
