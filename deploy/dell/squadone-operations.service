[Unit]
Description=SquadOne Central de Operacoes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/SquadOne
EnvironmentFile=%h/.config/squadone/operations.env
# Credencial da Pluggy (PLUGGY_CLIENT_ID, _SECRET, _ITEM_IDS): 600, fora do repo,
# do n8n e de data/; só este processo a lê. O "-" deixa a Central subir sem ela.
EnvironmentFile=-%h/.config/squadone/financas.env
Environment=APP_URL=http://127.0.0.1:9120
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# Todo arquivo que o processo cria nasce 600 (financas.db e a cópia, RULES 24).
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# squadone-operations: status.json, projetos. squadone: o diretório da agenda
# (SQUADONE_DATA_DIR: roster de produção, google-auth.json, offset do Telegram),
# fora do clone. avisos/fila: a fila que o dell-status drena para o WhatsApp.
# O "-" deixa o serviço subir antes do cutover, quando as duas últimas ainda
# não existem. %h/SquadOne/data fica até o runbook mover a credencial do Google.
# .codex: o `codex exec` da Luna em sombra grava as sessões lá (risco aceito do
# disco sem cifra, ARCHITECTURE "Luna em modo sombra"); sem isto ele falha.
ReadWritePaths=%h/.local/share/squadone-operations %h/SquadOne/data -%h/.local/share/squadone -%h/.local/share/avisos/fila -%h/.codex

[Install]
WantedBy=default.target
