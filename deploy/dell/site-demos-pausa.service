[Unit]
Description=Site antes da venda — pausa na Vercel o demo de quem recusou ou expirou há 15 dias
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# vercel (renova o token da CLI) mora em ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/bin/site-demos-pausa
TimeoutStartSec=15min
