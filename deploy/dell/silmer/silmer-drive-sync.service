[Unit]
Description=Bidirectional sync for Silmer with Google Drive
StartLimitIntervalSec=0

[Service]
Type=oneshot
# %h é a home de quem roda a unit de usuário; o systemd já define HOME, só o RCLONE_CONFIG é preciso.
Environment=RCLONE_CONFIG=%h/.config/rclone/rclone.conf
ExecStart=%h/.local/bin/silmer-drive-sync
TimeoutStartSec=30min
