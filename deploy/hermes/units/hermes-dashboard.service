[Unit]
Description=Hermes Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/romulo-sutil-corr-a/.hermes/hermes-agent
ExecStart=/home/romulo-sutil-corr-a/.hermes/hermes-agent/venv/bin/python /home/romulo-sutil-corr-a/.hermes/hermes-agent/hermes dashboard --host 127.0.0.1 --port 9119 --no-open --skip-build
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
