node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# data/ e um volume montado em producao: tudo que mora aqui e escrito em
# runtime e sombreado pelo mount. A seed versionada fica em seed/, FORA do
# volume, senao o primeiro boot com volume vazio nao acha de onde semear.
data/

# pacotes brutos do CraftPix (~55MB): a licenca free nao permite redistribuir
# os fontes. Os strips derivados ficam em public/sprites e sao versionados.
assets/craftpix/

# Cache local de tooling (MCP graphify/headroom/tokensave): regenerado por
# comando (`graphify update .`), inclui .db/.wal binarios — nao versiona.
graphify-out/
.headroom/
.tokensave/

# Relatórios, capturas e cópias de trabalho locais; não são fontes do app.
output/
brag-output*/

# notas de sessão locais (Claude/Codex); não versionar
CHECKPOINT.md
__pycache__/
.claude/worktrees/

# Saídas locais e cópias de trabalho não são fontes do aplicativo.
output/
brag-output*/

outputs/

.dist-*/

.impeccable/

package-lock.json
