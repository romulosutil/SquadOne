# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Client ID (tipo "Web application") do
# projeto Google Cloud, com a origem do app em "Authorized JavaScript origins"
# (ex: http://localhost:3000). Usado pelo GIS token client no browser (§3.4).
# Client ID e publico por desenho; nao ha client secret neste fluxo.
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: secret do MESMO OAuth Client acima. So o servidor le
# esta variavel — nunca use prefixo VITE_, senao ela entra no bundle do
# browser. Necessaria para o authorization code flow (troca de code e refresh).
GOOGLE_CLIENT_SECRET="MY_GOOGLE_OAUTH_CLIENT_SECRET"

# TOKEN_ENC_KEY: 32 bytes em base64. Cifra o refresh_token guardado em
# data/google-auth.json. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida a credencial guardada: basta reconectar.
TOKEN_ENC_KEY="MY_BASE64_32_BYTE_KEY"

# IPS_PERMITIDOS: lista separada por virgula. So estes IPs entram; qualquer
# outro leva 403 antes de qualquer rota. VAZIO DESLIGA o porteiro, que e o
# default em dev. Em producao o IP real vem do X-Forwarded-For do Traefik.
# Cuidado: IP residencial muda. Se perder o acesso, esvazie esta variavel no
# Easypanel e implante de novo.
IPS_PERMITIDOS=""

# JANELA_TRABALHO: horario em que o servidor pode alocar blocos, HH:MM-HH:MM,
# minutos multiplos de 15 (:00, :15, :30, :45),
# fuso America/Sao_Paulo. Vazio ou ausente = 09:00-19:00. Valor ilegivel faz o
# turno responder 500 (configuracao), nunca cai calado no padrao.
JANELA_TRABALHO="09:00-19:00"

# DIAS_TRABALHO: dias ISO separados por virgula, 1 = segunda ... 7 = domingo.
# Vazio ou ausente = 1,2,3,4,5. Trocar qualquer um dos dois exige Implantar
# (restart, sem rebuild: nao e VITE_).
DIAS_TRABALHO="1,2,3,4,5"

# TELEGRAM_BOT_TOKEN: token do bot criado no @BotFather. Vazio ou ausente = bot
# desligado (as abaixo sao ignoradas). Presente, TELEGRAM_CHAT_IDS e (no
# transporte webhook) TELEGRAM_WEBHOOK_SECRET sao obrigatorias; qualquer uma
# invalida = erro no log do boot e bot desligado.
# Em dev deixe VAZIO (ou use outro bot): o boot so registra o webhook em
# producao, mas o mesmo token em dois lugares confunde o teste.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_TRANSPORTE: webhook (padrao, Easypanel: o Telegram faz POST na rota
# publica) ou polling (Dell: o processo busca com getUpdates, sem URL publica;
# nunca chama setWebhook). No perfil operations so polling e aceito. Trocar de
# um para o outro exige o deleteWebhook do runbook (deploy/dell/CUTOVER-AGENDA.md).
TELEGRAM_TRANSPORTE=""

# TELEGRAM_WEBHOOK_SECRET: so no transporte webhook (no polling e ignorada).
# 32 a 256 caracteres [A-Za-z0-9_-]. O Telegram manda
# no header X-Telegram-Bot-Api-Secret-Token; sem ele o webhook responde 401.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar exige Implantar: o boot registra o webhook de novo com o valor novo.
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_CHAT_IDS: chat_id das conversas privadas autorizadas, por virgula.
# VAZIA NAO ABRE O BOT (ao contrario de IPS_PERMITIDOS). Para descobrir o seu:
# mande /start ao bot e procure "[telegram] chat" no log (evite acentos na busca).
TELEGRAM_CHAT_IDS=""

# Perfil de execução. No EasyPanel mantenha `app`. No Dell use `operations`;
# esse perfil força o bind do Express em 127.0.0.1 e habilita somente então as
# rotas locais da Central.
SQUADONE_MODE="app"

# Obrigatórios apenas em `operations`. O arquivo real e o diretório de dados
# ficam fora do Git; veja config/operations.example.json.
SQUADONE_OPERATIONS_CONFIG=""
SQUADONE_OPERATIONS_DATA_DIR=""

# SQUADONE_DATA_DIR: onde ficam squad.json, google-auth.json e o offset do
# Telegram. Vazio = ./data (o volume /app/data no Easypanel). No Dell e
# ~/.local/share/squadone, FORA do clone, com caminho absoluto: no perfil
# operations a agenda (roster, turno, Mochila, vigia, bot) so liga com ela
# presente e fora do checkout, e nunca semeia (sem squad.json = 503).
SQUADONE_DATA_DIR=""

# SQUADONE_ROSTER_CONGELADO: "true" recusa toda escrita no roster (409) durante
# a copia, a comparacao e a troca do cutover. Fica "true" no Easypanel depois
# dele (reserva fria). Qualquer outro valor = destravado.
SQUADONE_ROSTER_CONGELADO=""

# So no perfil operations (Dell):
# SQUADONE_LOGINS_TAILSCALE: logins da tailnet (e-mail do Tailscale) aceitos no
# header Tailscale-User-Login que o Serve poe em cada pedido, por virgula. Com
# a agenda ligada, VAZIA FECHA a tailnet (403 em todo pedido pelo Serve).
SQUADONE_LOGINS_TAILSCALE=""
# SQUADONE_AVISOS_FILA: pasta da fila de avisos que o dell-status drena para o
# WhatsApp. Vazia = ~/.local/share/avisos/fila.
SQUADONE_AVISOS_FILA=""
# DEADMAN_URL: URL de ping do healthchecks.io (https, sem query). Ping a cada
# minuto; /fail com a sessao do WhatsApp fora ha mais de 15 min. Vazia = sem sinal.
DEADMAN_URL=""
