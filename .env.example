# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Client ID (tipo "Web application") do
# projeto Google Cloud, com a origem do app em "Authorized JavaScript origins"
# (ex: http://localhost:3000). Usado pelo GIS token client no browser (§3.4).
# Client ID e publico por desenho; nao ha client secret neste fluxo.
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: secret do MESMO OAuth Client acima. So o servidor le
# esta variavel — nunca use prefixo VITE_, senao ela entra no bundle do
# browser. Necessaria para o authorization code flow (troca de code e refresh).
GOOGLE_CLIENT_SECRET="MY_GOOGLE_OAUTH_CLIENT_SECRET"

# TOKEN_ENC_KEY: 32 bytes em base64. Cifra o refresh_token guardado em
# data/google-auth.json. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida a credencial guardada: basta reconectar.
TOKEN_ENC_KEY="MY_BASE64_32_BYTE_KEY"

# IPS_PERMITIDOS: lista separada por virgula. So estes IPs entram; qualquer
# outro leva 403 antes de qualquer rota. VAZIO DESLIGA o porteiro, que e o
# default em dev. Em producao o IP real vem do X-Forwarded-For do Traefik.
# Cuidado: IP residencial muda. Se perder o acesso, esvazie esta variavel no
# Easypanel e implante de novo.
IPS_PERMITIDOS=""

# JANELA_TRABALHO: horario em que o servidor pode alocar blocos, HH:MM-HH:MM,
# minutos multiplos de 15 (:00, :15, :30, :45),
# fuso America/Sao_Paulo. Vazio ou ausente = 09:00-19:00. Valor ilegivel faz o
# turno responder 500 (configuracao), nunca cai calado no padrao.
JANELA_TRABALHO="09:00-19:00"

# DIAS_TRABALHO: dias ISO separados por virgula, 1 = segunda ... 7 = domingo.
# Vazio ou ausente = 1,2,3,4,5. Trocar qualquer um dos dois exige Implantar
# (restart, sem rebuild: nao e VITE_).
DIAS_TRABALHO="1,2,3,4,5"

# LEMBRETES_NTFY_URL: servidor ntfy PROPRIO + topico para os lembretes push,
# com o access token do ntfy como senha na URL (usuario vazio):
#   https://:tk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX@ntfy.seu-dominio/squadone-lembretes
# Vazio ou ausente = push desligado, o resto do app igual. Valor ilegivel =
# erro no log do boot e push desligado (nao derruba nada). Nunca use ntfy.sh:
# o titulo do compromisso vai na notificacao. Em dev use OUTRO topico, senao
# o `npm run dev` com a mesma credencial do Google duplica os avisos do celular.
LEMBRETES_NTFY_URL=""
