{
  "name": "squadone-escritorio-pixi-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js --config vite.config.ts",
    "build": "node ../../node_modules/vite/bin/vite.js build --config vite.config.ts",
    "verify": "node verify.mjs",
    "verify:lifecycle": "node verify-lifecycle.mjs",
    "preview": "node ../../node_modules/vite/bin/vite.js preview --config vite.config.ts --host 127.0.0.1 --port 4180 --strictPort",
    "lint": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pngjs": "7.0.0"
  }
}
